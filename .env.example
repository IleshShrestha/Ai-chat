# Copy to .env.local and fill in.

# OpenAI (server-only — never prefix with NEXT_PUBLIC_)
OPENAI_API_KEY=your_openai_api_key_here

# Supabase — from Dashboard → Project Settings → API.
# The anon key is safe to expose to the browser; RLS enforces access.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Cloudflare Turnstile (CAPTCHA for guest sign-in).
# Site key is public; the SECRET key goes in Supabase → Auth → Attack Protection.
# Local dev test key that always passes: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
